{
  "name": "@cwa-design/react",
  "version": "0.1.0-alpha.2",
  "description": "Apple-style glass material web components for React. CWA Design.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-styles.mjs && tsc -p tsconfig.build.json && node scripts/generate-metas.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "motion": "13.5.0"
  },
  "devDependencies": {
    "@cwa-design/registry": "workspace:*",
    "@cwa-design/tokens": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2"
  }
}
