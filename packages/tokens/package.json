{
  "name": "@cwa-design/tokens",
  "version": "0.1.0-alpha.1",
  "description": "Design tokens for CWA Design: framework-agnostic JSON source and generated CSS variables.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/tokens.json",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
