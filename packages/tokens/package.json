  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate.ts && node scripts/validate-css-tokens.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "zod": "4.6.5"
  }
}
