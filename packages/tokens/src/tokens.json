      "color-scrim": { "value": "rgba(0,0,0,0.30)", "type": "color", "description": "模态遮罩" },
      "glass-regular-fill": {
        "value": "rgba(255,255,255,0.78)",
        "type": "color",
        "description": "regular 玻璃填充"
      },
      "glass-thick-fill": {
        "value": "rgba(255,255,255,0.90)",
        "type": "color",
        "description": "厚 frosted 填充"
      },
      "glass-clear-fill": {
        "value": "rgba(255,255,255,0.42)",
        "type": "color",
        "description": "clear 玻璃填充"
      }
    },
    "dark": {
      "color-bg": { "value": "#1c1c1e", "type": "color", "description": "页面底色" },
      "color-surface": { "value": "#2c2c2e", "type": "color", "description": "实色表面" },
      "color-surface-raised": {
        "value": "#3a3a3c",
        "type": "color",
        "description": "悬浮实色表面"
      },
      "color-text": { "value": "#f5f5f7", "type": "color", "description": "主文本" },
      "color-text-muted": { "value": "#aeaeb2", "type": "color", "description": "次要文本" },
      "color-border-subtle": {
        "value": "rgba(255,255,255,0.14)",
        "type": "color",
        "description": "弱边框"
      },
      "color-border-strong": {
        "value": "rgba(255,255,255,0.30)",
        "type": "color",
        "description": "强边框/分隔"
      },
      "color-accent": { "value": "#409cff", "type": "color", "description": "主操作色" },
      "color-on-accent": { "value": "#ffffff", "type": "color", "description": "主操作色上的文本" },
      "color-danger": { "value": "#ff6961", "type": "color", "description": "错误/破坏性" },
      "color-success": { "value": "#66d17c", "type": "color", "description": "成功" },
      "color-warning": { "value": "#ffd60a", "type": "color", "description": "警告" },
      "color-scrim": { "value": "rgba(0,0,0,0.48)", "type": "color", "description": "模态遮罩" },
      "glass-regular-fill": {
        "value": "rgba(44,44,46,0.72)",
        "type": "color",
        "description": "regular 玻璃填充"
      },
      "glass-thick-fill": {
        "value": "rgba(28,28,30,0.88)",
        "type": "color",
        "description": "厚 frosted 填充"
      },
      "glass-clear-fill": {
        "value": "rgba(44,44,46,0.40)",
        "type": "color",
        "description": "clear 玻璃填充"
      }
    }
  },
  "motion": {
    "control": { "type": "duration", "value": "100ms", "description": "控件反馈时长" },
    "move": {
      "type": "spring",
      "bounce": 0,
      "duration": 0.4,
      "description": "布局/位置移动：临界阻尼"
    },
    "overlay": {
      "type": "spring",
      "bounce": 0,
      "duration": 0.3,
      "description": "菜单/Popover：临界阻尼，触发器原点"
    },
    "sheet": {
      "type": "spring",
      "bounce": 0.15,
      "duration": 0.35,
      "description": "Sheet：释放动量允许少量回弹"
    }
  }
}
