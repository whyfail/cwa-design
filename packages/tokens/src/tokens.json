{
  "$schema": "cwa-tokens@1",
  "libraryVersion": "0.1.0-alpha.0",
  "primitive": {
    "space": {
      "1": {
        "value": "0.25rem",
        "type": "dimension",
        "unit": "rem",
        "description": "最小间距（图标与文本之间）"
      },
      "2": { "value": "0.5rem", "type": "dimension", "unit": "rem", "description": "紧凑内间距" },
      "3": { "value": "0.75rem", "type": "dimension", "unit": "rem", "description": "控件内间距" },
      "4": { "value": "1rem", "type": "dimension", "unit": "rem", "description": "标准内间距" },
      "5": { "value": "1.5rem", "type": "dimension", "unit": "rem", "description": "组间距" },
      "6": { "value": "2rem", "type": "dimension", "unit": "rem", "description": "区块间距" },
      "8": { "value": "3rem", "type": "dimension", "unit": "rem", "description": "页面级间距" }
    },
    "radius": {
      "control": {
        "value": "0.75rem",
        "type": "dimension",
        "unit": "rem",
        "description": "按钮/输入框圆角"
      },
      "panel": {
        "value": "1.25rem",
        "type": "dimension",
        "unit": "rem",
        "description": "卡片/面板圆角"
      },
      "sheet": {
        "value": "1.5rem",
        "type": "dimension",
        "unit": "rem",
        "description": "Sheet/大浮层圆角"
      }
    },
    "font": {
      "size-caption": {
        "value": "0.8125rem",
        "type": "dimension",
        "unit": "rem",
        "description": "辅助文字"
      },
      "size-body": { "value": "1rem", "type": "dimension", "unit": "rem", "description": "正文" },
      "size-title": {
        "value": "1.25rem",
        "type": "dimension",
        "unit": "rem",
        "description": "区块标题"
      },
      "size-display": {
        "value": "1.75rem",
        "type": "dimension",
        "unit": "rem",
        "description": "页面标题"
      },
      "leading-body": {
        "value": "1.5",
        "type": "number",
        "unit": "ratio",
        "description": "正文行高"
      },
      "leading-display": {
        "value": "1.15",
        "type": "number",
        "unit": "ratio",
        "description": "大标题行高（紧）"
      },
      "tracking-display": {
        "value": "-0.02em",
        "type": "dimension",
        "unit": "em",
        "description": "大标题字距（负，需验证中文）"
      }
    },
    "blur": {
      "glass-clear": {
        "value": "12px",
        "type": "dimension",
        "unit": "px",
        "description": "clear 玻璃（媒体控件，opt-in）"
      },
      "glass-regular": {
        "value": "20px",
        "type": "dimension",
        "unit": "px",
        "description": "regular 玻璃（浮动层/导航）"
      },
      "glass-thick": {
        "value": "40px",
        "type": "dimension",
        "unit": "px",
        "description": "厚 frosted（Dialog/Sheet/Sidebar）"
      }
    },
    "saturation": {
      "glass": {
        "value": "1.5",
        "type": "number",
        "unit": "ratio",
        "description": "玻璃饱和度增益"
      }
    }
  },
  "semantic": {
    "light": {
      "color-bg": { "value": "#f5f5f7", "type": "color", "description": "页面底色" },
      "color-surface": { "value": "#ffffff", "type": "color", "description": "实色表面" },
      "color-surface-raised": {
        "value": "#ffffff",
        "type": "color",
        "description": "悬浮实色表面"
      },
      "color-text": { "value": "#17181c", "type": "color", "description": "主文本" },
      "color-text-muted": { "value": "#464a54", "type": "color", "description": "次要文本" },
      "color-border-subtle": {
        "value": "rgba(0,0,0,0.10)",
        "type": "color",
        "description": "弱边框"
      },
      "color-border-strong": {
        "value": "rgba(0,0,0,0.22)",
        "type": "color",
        "description": "强边框/分隔"
      },
