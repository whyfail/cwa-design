    "Tabs.Panel": {
      "exportName": "Tabs.Panel",
      "typeName": "TabsPanelProps",
      "sourceTypePath": "@base-ui/react/tabs#TabsPanelProps",
      "description": "Base UI Panel 直接导出。",
      "props": {},
