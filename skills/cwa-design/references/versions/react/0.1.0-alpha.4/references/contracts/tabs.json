      "exportName": "TabsList",
      "typeName": "TabsListProps",
      "sourceTypePath": "packages/react/src/tabs/tabs.tsx#TabsListProps",
      "description": "CWA 样式 List；只接受这里列出的 props。需要 activateOnFocus 时使用 Tabs.List。",
      "props": {
        "children": {
          "type": "node",
          "summary": "ReactNode；内容由调用方提供",
          "required": false
